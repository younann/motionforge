      ".mc{padding:24px 28px}header{display:flex;justify-content:space-between;align-items:center;height:44px;margin-bottom:20px}",
      "header h1{margin:0;font:700 24px 'Syne'}header small{color:#8A8FA8;font-size:12px}.hr{display:flex;gap:10px;align-items:center}",
      ".pill{font:500 13px Inter;padding:9px 14px;border:1px solid #E1E4EE;border-radius:10px;background:#fff}",
      ".btn{font:600 13px Inter;padding:10px 16px;border-radius:10px;background:#0F1222;color:#fff}.avs{display:flex}",
      ".avs i{width:30px;height:30px;border-radius:50%;border:2px solid #F4F6FB;margin-left:-8px}",
      ".card{background:#fff;border:1px solid #E6E8F0;border-radius:16px;box-shadow:0 1px 2px rgba(15,18,34,.04),0 8px 24px rgba(15,18,34,.04)}",
